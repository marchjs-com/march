{
  "name": "hadi-march",
  "version": "0.1.0",
  "private": true,
  "description": "HADI March: a tiny, fine-grained reactive UI library. Signals instead of a virtual DOM, JSX compiled by an esbuild plugin, zero runtime dependencies, CSP and Trusted Types friendly.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./router": "./src/router/index.ts",
    "./data": "./src/data/index.ts",
    "./schema": "./src/schema/index.ts",
    "./ui": "./src/ui/index.ts",
    "./table": "./src/table/index.ts",
    "./charts": "./src/charts/index.ts",
    "./testing": "./src/testing/index.ts",
    "./compiler": "./compiler/index.js",
    "./esbuild": "./compiler/esbuild.js",
    "./css/*": "./src/css/*",
    "./charts/charts.css": "./src/charts/charts.css",
    "./crud": "./src/crud/index.ts",
    "./forms": "./src/forms/index.ts",
    "./register": "./compiler/register.js",
    "./lazy": "./src/lazy/index.ts",
    "./sw": "./src/sw/index.ts",
    "./motion": "./src/motion/index.ts",
    "./motion/motion.css": "./src/motion/motion.css",
    "./motion/text": "./src/motion/text/index.ts",
    "./motion/text/meta": "./src/motion/text/meta.ts",
    "./fx": "./src/fx/index.ts",
    "./fx/fx.css": "./src/fx/fx.css",
    "./store": "./src/store/index.ts",
    "./channel": "./src/channel/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./i18n/tr": "./src/i18n/tr.ts",
    "./icons": "./src/icons/index.ts",
    "./icons/catalog": "./src/icons/catalog.ts",
    "./theme": "./src/theme/index.ts",
    "./motion/install": "./src/motion/install.ts",
    "./css/themes/*": "./src/css/themes/*",
    "./widget": "./src/widget/index.ts",
    "./net": "./src/net/index.ts",
    "./net/mock": "./src/net/mock.ts",
    "./errors": "./src/errors/index.ts",
    "./errors/errors.css": "./src/errors/errors.css",
    "./managers": "./src/managers/index.ts",
    "./managers/viewport": "./src/managers/viewport/index.ts",
    "./managers/consent": "./src/managers/consent/index.ts",
    "./managers/consent/ui": "./src/managers/consent/ui.ts",
    "./managers/command": "./src/managers/command/index.ts",
    "./managers/command/ui": "./src/managers/command/ui.ts",
    "./managers/channels": "./src/managers/channels/index.ts",
    "./managers/idle": "./src/managers/idle/index.ts",
    "./managers/sync": "./src/managers/sync/index.ts",
    "./managers/device": "./src/managers/device/index.ts",
    "./managers/location": "./src/managers/location/index.ts",
    "./managers/notification": "./src/managers/notification/index.ts",
    "./managers/permission": "./src/managers/permission/index.ts",
    "./managers/window": "./src/managers/window/index.ts",
    "./managers/scroll": "./src/managers/scroll/index.ts",
    "./managers/session": "./src/managers/session/index.ts",
    "./managers/presence": "./src/managers/presence/index.ts",
    "./managers/clipboard": "./src/managers/clipboard/index.ts",
    "./managers/undo": "./src/managers/undo/index.ts",
    "./managers/dirty": "./src/managers/dirty/index.ts",
    "./managers/storage": "./src/managers/storage/index.ts",
    "./managers/cache": "./src/managers/cache/index.ts",
    "./managers/config": "./src/managers/config/index.ts",
    "./managers/flags": "./src/managers/flags/index.ts",
    "./managers/log": "./src/managers/log/index.ts",
    "./managers/perf": "./src/managers/perf/index.ts",
    "./managers/rate": "./src/managers/rate/index.ts"
  },
  "bin": {
    "march": "./cli/march.js"
  },
  "files": [
    "src",
    "compiler",
    "cli",
    "types",
    "README.md",
    "README.tr.md",
    "LICENSE"
  ],
  "types": "./src/index.ts",
  "scripts": {
    "test": "node --import ./compiler/register.js --test",
    "bench": "node bench/run.js",
    "size": "node bench/size.js",
    "typecheck": "tsc -p tsconfig.json",
    "build:lib": "node tools/build-lib.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  },
  "sideEffects": [
    "*.css",
    "./src/motion/install.ts",
    "./src/net/index.ts",
    "./src/net/mock.ts",
    "./src/errors/index.ts",
    "./src/managers/*/index.ts",
    "./src/managers/*/ui.ts"
  ]
}
